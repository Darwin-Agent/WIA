diff --git a/python/sglang/srt/entrypoints/http_server.py b/python/sglang/srt/entrypoints/http_server.py
index dd808d6..0534dc3 100644
--- a/python/sglang/srt/entrypoints/http_server.py
+++ b/python/sglang/srt/entrypoints/http_server.py
@@ -2446,16 +2446,29 @@ def _freeze_gc_after_server_warmup(server_args: ServerArgs):
     freeze_headers = {}
     if freeze_key:
         freeze_headers["Authorization"] = f"Bearer {freeze_key}"
-    try:
-        res = requests.post(
-            server_args.url() + "/freeze_gc",
-            headers=freeze_headers,
-            timeout=10,
-            verify=server_args.ssl_verify(),
-        )
-        res.raise_for_status()
-    except requests.exceptions.RequestException:
-        logger.warning("post-warmup freeze_gc failed", exc_info=True)
+
+    # The warmup thread starts before uvicorn binds its listening socket.
+    # In multi-node deployments server_args.host is often a service hostname
+    # rather than loopback, so the first self-request can race the HTTP server
+    # startup and fail with ConnectionRefused. Retry briefly until the server
+    # is actually listening, then fall back to the previous warning behavior.
+    freeze_url = server_args.url() + "/freeze_gc"
+    deadline = time.monotonic() + 30.0
+    while True:
+        try:
+            res = requests.post(
+                freeze_url,
+                headers=freeze_headers,
+                timeout=10,
+                verify=server_args.ssl_verify(),
+            )
+            res.raise_for_status()
+            return
+        except requests.exceptions.RequestException:
+            if time.monotonic() >= deadline:
+                logger.warning("post-warmup freeze_gc failed", exc_info=True)
+                return
+            time.sleep(0.5)
 
 
