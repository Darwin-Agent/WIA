+
+def _parse_dumper_kv_pairs(raw: str | None) -> dict[str, Any]:
+    if not raw:
+        return {}
+
+    overrides: dict[str, Any] = {}
+    for token in raw.split():
+        key, separator, value = token.partition("=")
+        if not separator:
+            raise ValueError(f"Invalid dumper override {token!r}; expected key=value")
+        overrides[key] = _parse_dumper_value(value)
+    return overrides
+
+
+def _parse_dumper_value(value: str) -> Any:
+    lowered = value.lower()
+    if lowered in {"true", "false"}:
+        return lowered == "true"
+    try:
+        return ast.literal_eval(value)
+    except (ValueError, SyntaxError):
+        return value
 
 
