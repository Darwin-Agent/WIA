{%- if not add_generation_prompt is defined -%}
  {%- set add_generation_prompt = false -%}
{%- endif -%}
{%- if not thinking is defined -%}
  {%- set thinking = false -%}
{%- endif -%}
{%- if not reasoning_effort is defined -%}
  {%- set reasoning_effort = 'low' -%}
{%- endif -%}
{%- if not drop_thinking is defined -%}
  {%- set drop_thinking = true -%}
{%- endif -%}
{%- if tools is defined and tools is not none and tools|length > 0 -%}
  {%- set drop_thinking = false -%}
{%- endif -%}

{%- set ns = namespace(is_first_system=true, system_prompt='', tool_schemas='', last_user_index=-1) -%}

{%- for message in messages -%}
  {%- if message['role'] in ['user', 'developer'] -%}
    {%- set ns.last_user_index = loop.index0 -%}
  {%- endif -%}
  {%- if message['role'] == 'system' -%}
    {%- set system_content = message['content'] if message['content'] is not none else '' -%}
    {%- if ns.is_first_system -%}
      {%- set ns.system_prompt = system_content -%}
      {%- set ns.is_first_system = false -%}
    {%- else -%}
      {%- set ns.system_prompt = ns.system_prompt ~ '\n\n' ~ system_content -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if tools is defined and tools is not none and tools|length > 0 -%}
  {%- for tool in tools -%}
    {%- set func = tool.function if tool.function is defined else tool -%}
    {%- set ns.tool_schemas = ns.tool_schemas ~ (func | tojson) ~ '\n' -%}
  {%- endfor -%}
  {%- set ns.system_prompt = ns.system_prompt ~ '\n\n## Tools\n\nYou have access to a set of tools to help answer the user\'s question. You can invoke tools by writing a "<｜DSML｜tool_calls>" block like the following:\n\n<｜DSML｜tool_calls>\n<｜DSML｜invoke name="$TOOL_NAME">\n<｜DSML｜parameter name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE</｜DSML｜parameter>\n...\n</｜DSML｜invoke>\n<｜DSML｜invoke name="$TOOL_NAME2">\n...\n</｜DSML｜invoke>\n</｜DSML｜tool_calls>\n\nString parameters should be specified as is and set `string="true"`. For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.\n\nIf thinking_mode is enabled (triggered by <think>), you MUST output your complete reasoning inside <think>...</think> BEFORE any tool calls or final response.\n\nOtherwise, output directly after </think> with tool calls or final response.\n\n### Available Tool Schemas\n\n' ~ ns.tool_schemas ~ '\nYou MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.\n' -%}
{%- endif -%}

{%- if thinking and reasoning_effort == 'high' -%}
Reasoning Effort: Absolute maximum with no shortcuts permitted.
You MUST be very thorough in your thinking and comprehensively decompose the problem to resolve the root cause, rigorously stress-testing your logic against all potential paths, edge cases, and adversarial scenarios.
Explicitly write out your entire deliberation process, documenting every intermediate step, considered alternative, and rejected hypothesis to ensure absolutely no assumption is left unchecked.

{%- elif thinking and reasoning_effort == 'max' -%}
Reasoning Effort: Beyond maximum — exhaustive, relentless, and uncompromising.
You MUST reason with the utmost depth and rigor, leaving absolutely nothing to chance: exhaustively decompose the problem into its most fundamental components, trace every causal chain to its root, and resolve the underlying cause rather than any surface symptom.
Do not stop reasoning until you have independently verified the solution from multiple angles and are certain that no assumption remains unchecked and no error remains undiscovered.

{%- endif -%}
<｜begin▁of▁sentence｜>{{ ns.system_prompt }}
{%- for message in messages -%}
  {%- if message['role'] == 'system' -%}
  {%- elif message['role'] in ['user', 'developer'] -%}
    {%- set content = message['content'] if message['content'] is not none else '' -%}
<｜User｜>{{ content }}
    {%- if not loop.last and messages[loop.index0 + 1]['role'] in ['assistant', 'latest_reminder'] -%}
<｜Assistant｜>{% if thinking and (not drop_thinking or loop.index0 >= ns.last_user_index) %}<think>{% else %}</think>{% endif %}
    {%- endif -%}
  {%- elif message['role'] == 'latest_reminder' -%}
    {%- set content = message['content'] if message['content'] is not none else '' -%}
<｜latest_reminder｜>{{ content }}
  {%- elif message['role'] == 'tool' -%}
    {%- set content = message['content'] if message['content'] is not none else '' -%}
<tool_result>{{ content }}</tool_result>
  {%- elif message['role'] == 'assistant' -%}
    {%- set content = message['content'] if message['content'] is not none else '' -%}
    {%- set reasoning = '' -%}
    {%- if thinking and message['reasoning_content'] is defined and message['reasoning_content'] is not none and message['reasoning_content']|string|trim -%}
      {%- set reasoning = message['reasoning_content'] ~ '</think>' -%}
    {%- endif -%}
    {%- set tool_calls = message['tool_calls'] if message['tool_calls'] is defined and message['tool_calls'] is not none else [] -%}
    {{ reasoning }}{{ content }}
    {%- if tool_calls|length > 0 -%}

<｜DSML｜tool_calls>
      {%- for tool_call in tool_calls -%}
<｜DSML｜invoke name="{{ tool_call.function.name }}">
        {%- if tool_call.function.arguments is string -%}
{{ tool_call.function.arguments }}
        {%- else -%}
{{ tool_call.function.arguments | tojson }}
        {%- endif -%}
</｜DSML｜invoke>
      {%- endfor -%}
</｜DSML｜tool_calls>
    {%- endif -%}
<｜end▁of▁sentence｜>
  {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
  {%- set has_non_system = messages | rejectattr('role', 'equalto', 'system') | list | length -%}
  {%- set last_role = messages[-1]['role'] if messages|length > 0 else '' -%}
  {%- if has_non_system == 0 or last_role in ['user', 'developer'] -%}
<｜Assistant｜>{% if thinking %}<think>{% else %}</think>{% endif %}
  {%- endif -%}
{%- endif -%}
